  {
    "name": "propose_section",
    "description": "Write the shape of a section yourself when it has no usable traced curve or you judge the trace wrong (you may also correct, complete or fair a trace). form half_breadths: offsets_m = 5-24 [height_m, half_breadth_m] pairs in metres; blend: the two neighbouring sections blended by station position and scaled by fullness (0.5-1.5, 1 = plain blend); standard_form: U or V section with beam_m, draft_m and optional bilge_radius_m, deadrise_deg. basis: one line on what you based it on. replaces: 'none' or the traced candidate id it corrects. The host fairs the curve, clamps it to the declared beam and depth, shows it on the source panel with warnings; build_draft then uses it, labelled ai_inferred or ai_corrected. The labels are ai_inferred when replaces is 'none' and ai_corrected when it names a traced candidate.",
    "parameters": {
      "type": "object",
      "properties": {
        "section_id": {
          "type": "string",
          "maxLength": 64
        },
        "form": {
          "enum": [
            "half_breadths",
            "blend",
            "standard_form"
          ]
        },
        "basis": {
          "type": "string",
          "maxLength": 300
        },
        "replaces": {
          "type": "string",
          "maxLength": 64
        },
        "offsets_m": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 5,
          "maxItems": 24
        },
        "fullness": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "shape": {
          "enum": [
            "U",
            "V"
          ]
        },
        "beam_m": {
          "type": "number"
        },
        "draft_m": {
          "type": "number"
        },
        "bilge_radius_m": {
          "type": "number"
        },
        "deadrise_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 60.0
        }
      },
      "required": [
        "section_id",
        "form",
        "basis"
      ],
      "additionalProperties": false
    },
    "operation": "propose_section",
    "route": "worker",
    "tier": "draft",
    "python_catalog": true
