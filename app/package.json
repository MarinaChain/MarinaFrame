{
  "name": "marinaframe-app",
  "version": "0.5.0",
  "private": true,
  "description": "MarinaFrame desktop app (Tauri 2). The UI in ui/ is static files.",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "tauri build --config src-tauri/tauri.worker.conf.json",
    "build:no-worker": "tauri build",
    "test:ui": "node --test ui-tests/",
    "test:a11y": "node ui-tests/a11y.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "axe-core": "4.10.3",
    "playwright-core": "1.56.1"
  }
}
